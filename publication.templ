package margo

templ publicationDocument(metadata EditorialMetadata, input PublicationInput, social SocialMetadata, dependencies []publicationDependency, fingerprint string, fragment templ.Component) {
	<!doctype html>
	<html lang={ publicationLanguage(metadata) } class={ templ.KV("dark", input.ColorMode == ColorModeDark) } data-theme={ string(input.Theme) } data-color-mode={ string(input.ColorMode) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			if input.Mode == PublicationPublic {
				@socialPublicationMetadataTags(social, input.Kind, metadata)
			} else {
				<title>{ metadata.Title }</title>
				if metadata.Description != "" {
					<meta name="description" content={ metadata.Description }/>
				}
			}
			for _, dependency := range dependencies {
				@publicationDependencyComponent(dependency)
			}
		</head>
		<body>
			if input.Header != nil {
				<header class="margo-publication-header">@input.Header</header>
			}
			if input.body != nil {
				@input.body
			} else {
				<main data-margo-editorial-fingerprint={ fingerprint }>
					if input.Kind == PublicationArticle {
						@publicationArticleDetails(metadata)
					}
					@fragment
				</main>
			}
			if input.Footer != nil {
				<footer class="margo-publication-footer">@input.Footer</footer>
			}
		</body>
	</html>
}

templ publicationArticleDetails(metadata EditorialMetadata) {
	if len(metadata.Authors) > 0 || metadata.PublishedAt != "" || metadata.ModifiedAt != "" || len(metadata.Tags) > 0 {
		<header class="margo-publication-byline">
			if len(metadata.Authors) > 0 {
				<address aria-label="Authors">
					for index, author := range metadata.Authors {
						if index > 0 {
							<span aria-hidden="true">, </span>
						}
						<span rel="author">{ author }</span>
					}
				</address>
			}
			if metadata.PublishedAt != "" {
				<time datetime={ metadata.PublishedAt } data-publication-date="published">{ metadata.PublishedAt }</time>
			}
			if metadata.ModifiedAt != "" {
				<time datetime={ metadata.ModifiedAt } data-publication-date="modified">{ metadata.ModifiedAt }</time>
			}
			if len(metadata.Tags) > 0 {
				<ul aria-label="Tags">
					for _, tag := range metadata.Tags {
						<li>{ tag }</li>
					}
				</ul>
			}
		</header>
	}
}
