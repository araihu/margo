{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "type", "title", "slices"],
  "properties": {
    "schemaVersion": {"const": 1},
    "type": {"enum": ["pie", "doughnut"]},
    "title": {"type": "string", "minLength": 1},
    "slices": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "value"], "properties": {"name": {"type": "string", "minLength": 1}, "value": {"type": "number", "minimum": 0}}}}
  }
}
