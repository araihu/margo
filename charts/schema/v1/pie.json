{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "type", "title", "slices"],
  "properties": {
    "schemaVersion": {"const": 1},
    "type": {"enum": ["pie", "doughnut"]},
    "title": {"type": "string", "minLength": 1},
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "palette": {"enum": ["auto", "araihu", "bold", "neutral", "pastel", "status"]},
        "class": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\\"'<>;]+$"},
        "colors": {"type": "array", "maxItems": 12, "items": {"type": "string", "pattern": "^(|#[0-9A-Fa-f]{3,4}|#[0-9A-Fa-f]{6}|#[0-9A-Fa-f]{8})$"}}
      }
    },
    "slices": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "value"], "properties": {"name": {"type": "string", "minLength": 1}, "class": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\\"'<>;]+$"}, "color": {"type": "string", "pattern": "^(?:#[0-9A-Fa-f]{3,4}|#[0-9A-Fa-f]{6}|#[0-9A-Fa-f]{8})$"}, "value": {"type": "number", "minimum": 0}}}}
  }
}
