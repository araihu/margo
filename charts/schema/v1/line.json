{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "type", "title", "categories", "series"],
  "properties": {
    "schemaVersion": {"const": 1},
    "type": {"const": "line"},
    "title": {"type": "string", "minLength": 1},
    "categories": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "series": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "values"], "properties": {"name": {"type": "string", "minLength": 1}, "values": {"type": "array", "minItems": 1, "items": {"type": "number"}}}}}
  }
}
