{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "type", "title", "categories", "series"],
  "properties": {
    "schemaVersion": {"const": 1},
    "type": {"const": "line"},
    "renderer": {"description": "Use static SVG for every target. interactive is supported by HTML, site, and standalone PDF; deck HTML and PDF require static.", "enum": ["static", "interactive"]},
    "title": {"type": "string", "minLength": 1},
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "palette": {"enum": ["auto", "araihu", "bold", "neutral", "pastel", "status"]},
        "class": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\\"'<>;]+$"},
        "colors": {"type": "array", "maxItems": 12, "items": {"type": "string", "pattern": "^(|#[0-9A-Fa-f]{3,4}|#[0-9A-Fa-f]{6}|#[0-9A-Fa-f]{8})$"}}
      }
    },
    "categories": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "series": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "values"], "properties": {"name": {"type": "string", "minLength": 1}, "class": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\\"'<>;]+$"}, "color": {"type": "string", "pattern": "^(?:#[0-9A-Fa-f]{3,4}|#[0-9A-Fa-f]{6}|#[0-9A-Fa-f]{8})$"}, "values": {"type": "array", "minItems": 1, "items": {"type": "number"}}}}}
  }
}
