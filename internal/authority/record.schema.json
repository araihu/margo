{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "margo/canonical-authority/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordDigest", "canonicalOrigin", "routes", "owner", "asset", "host", "deployment", "receipt"],
  "properties": {
    "schemaVersion": {"const": "margo/canonical-authority/v1"},
    "recordDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonicalOrigin": {"type": "string", "format": "uri"},
    "routes": {
      "type": "object", "additionalProperties": false,
      "required": ["homepage", "representative", "preview"],
      "properties": {"homepage": {"const": "/"}, "representative": {"type": "string"}, "preview": {"const": "/assets/social/margo-v0.0.1.png"}}
    },
    "owner": {"type": "object", "additionalProperties": false, "required": ["principal", "contact"], "properties": {"principal": {"type": "string"}, "contact": {"type": "string"}}},
    "asset": {"type": "object", "additionalProperties": false, "required": ["url", "mimeType", "sha256", "bytes", "width", "height", "evidenceURL", "evidenceSHA256"], "properties": {"url": {"type": "string", "format": "uri"}, "mimeType": {"enum": ["image/png", "image/jpeg"]}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 1, "exclusiveMaximum": 1000000}, "width": {"const": 1280}, "height": {"const": 640}, "evidenceURL": {"type": "string", "format": "uri"}, "evidenceSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "host": {"$ref": "#/$defs/evidence"},
    "deployment": {"type": "object", "additionalProperties": false, "required": ["provider", "project", "deploymentID", "commit", "evidenceURL", "evidenceSHA256"], "properties": {"provider": {"type": "string"}, "project": {"type": "string"}, "deploymentID": {"type": "string"}, "commit": {"type": "string"}, "evidenceURL": {"type": "string", "format": "uri"}, "evidenceSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "receipt": {"type": "object", "additionalProperties": false, "required": ["transport", "source", "sha256", "verifier", "verifiedAt"], "properties": {"transport": {"enum": ["file", "https"]}, "source": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "verifier": {"type": "string"}, "verifiedAt": {"type": "string"}}}
  },
  "$defs": {"evidence": {"type": "object", "additionalProperties": false, "required": ["provider", "account", "resource", "evidenceURL", "evidenceSHA256"], "properties": {"provider": {"type": "string"}, "account": {"type": "string"}, "resource": {"type": "string"}, "evidenceURL": {"type": "string", "format": "uri"}, "evidenceSHA256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
