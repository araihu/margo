package margo

templ socialMetadataTags(metadata SocialMetadata) {
	@socialPublicationMetadataTags(metadata, PublicationDocument, EditorialMetadata{})
}

templ socialPublicationMetadataTags(metadata SocialMetadata, kind PublicationKind, editorial EditorialMetadata) {
	<title>{ metadata.Title }</title>
	<meta name="description" content={ metadata.Description }/>
	<link rel="canonical" href={ metadata.CanonicalURL }/>
	<meta property="og:url" content={ metadata.CanonicalURL }/>
	<meta property="og:type" content={ publicationOGType(kind) }/>
	<meta property="og:title" content={ metadata.Title }/>
	<meta property="og:description" content={ metadata.Description }/>
	<meta property="og:site_name" content={ metadata.SiteName }/>
	<meta property="og:image" content={ metadata.Image.URL }/>
	<meta property="og:image:type" content={ metadata.Image.MIMEType }/>
	<meta property="og:image:width" content={ fmtInt(metadata.Image.Width) }/>
	<meta property="og:image:height" content={ fmtInt(metadata.Image.Height) }/>
	<meta property="og:image:alt" content={ metadata.Image.Alt }/>
	if metadata.Locale != "" {
		<meta property="og:locale" content={ metadata.Locale }/>
	}
	<meta name="twitter:card" content="summary_large_image"/>
	<meta name="twitter:title" content={ metadata.Title }/>
	<meta name="twitter:description" content={ metadata.Description }/>
	<meta name="twitter:image" content={ metadata.Image.URL }/>
	<meta name="twitter:image:alt" content={ metadata.Image.Alt }/>
	if kind == PublicationArticle {
		if editorial.PublishedAt != "" {
			<meta property="article:published_time" content={ editorial.PublishedAt }/>
		}
		if editorial.ModifiedAt != "" {
			<meta property="article:modified_time" content={ editorial.ModifiedAt }/>
		}
		for _, author := range editorial.Authors {
			<meta property="article:author" content={ author }/>
		}
		for _, tag := range editorial.Tags {
			<meta property="article:tag" content={ tag }/>
		}
	}
}
