package margo

templ standalonePublicationBody(fingerprint, htmlFingerprint string, brand Brand, logoURL, backdropURL string, content templ.Component) {
	<a class="margo-skip-link" href="#margo-document-content" lang="en">Skip to main content</a>
	<div class="goshtoso-document" data-margo-render-instance="ri-00000000" data-margo-document-fingerprint={ fingerprint } data-margo-html-fingerprint={ htmlFingerprint }>
		if backdropURL != "" {
			<img class="goshtoso-document__backdrop" src={ backdropURL } alt="" aria-hidden="true"/>
		}
		if logoURL != "" || brand.Header != nil {
			<header class="goshtoso-document__header">
				if logoURL != "" {
					<img class="goshtoso-document__logo" src={ logoURL } alt={ brand.LogoAlt }/>
				}
				if brand.Header != nil {
					@brand.Header
				}
			</header>
		}
		if len(brand.Stamps) > 0 {
			<aside class="goshtoso-document__stamps" aria-label="Document status">
				for _, stamp := range brand.Stamps {
					<span class="goshtoso-document__stamp">{ stamp }</span>
				}
			</aside>
		}
		<main id="margo-document-content">
			@content
		</main>
		if brand.Watermark != "" {
			<span class="goshtoso-document__watermark" aria-hidden="true">{ brand.Watermark }</span>
		}
		if brand.Footer != nil {
			<footer class="goshtoso-document__footer">
				@brand.Footer
			</footer>
		}
	</div>
	@templ.Raw(standaloneScreenPreparationScript)
	@templ.Raw(standalonePrintPreparationScript)
}
