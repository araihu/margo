{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://araihu.github.io/margo/schema/v1/output/check-report.json",
  "title": "Margo check report v1",
  "description": "The JSON envelope emitted by margo check --diagnostics json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["diagnostics", "errors", "warnings"],
  "properties": {
    "diagnostics": {
      "description": "All findings, including warnings, in source order.",
      "type": "array",
      "items": {"$ref": "#/$defs/diagnostic"}
    },
    "policy": {"description": "SHA-256 identity of the trusted host policy when one was supplied.", "type": "string"},
    "errors": {"description": "Number of error-severity findings.", "type": "integer", "minimum": 0},
    "warnings": {"description": "Number of warning-severity findings.", "type": "integer", "minimum": 0}
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "enum": ["info", "warning", "error"]},
        "source": {"type": "string"},
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1},
        "pointer": {"type": "string"},
        "hint": {"type": "string"}
      }
    }
  }
}
